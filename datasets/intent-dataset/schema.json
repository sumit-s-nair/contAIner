{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IntentDatasetRow",
  "description": "Schema for a single row in the intent-dataset",
  "type": "object",
  "required": ["instruction", "intent_type", "entities", "entity_spans", "context"],
  "additionalProperties": false,
  "properties": {
    "instruction": {
      "type": "string",
      "description": "Raw user instruction"
    },
    "intent_type": {
      "type": "string",
      "description": "Classified intent type"
    },
    "entities": {
      "type": "object",
      "description": "Extracted entities from the instruction",
      "required": ["runtime", "package", "version"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "type": ["string", "null"],
          "description": "Runtime/language (e.g., python, node)"
        },
        "package": {
          "type": ["string", "null"],
          "description": "Package name"
        },
        "version": {
          "type": ["string", "null"],
          "description": "Version specifier"
        }
      }
    },
    "entity_spans": {
      "type": "object",
      "description": "Character spans for extracted entities",
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "oneOf": [
            { "$ref": "#/definitions/span" },
            { "type": "null" }
          ]
        },
        "package": {
          "oneOf": [
            { "$ref": "#/definitions/span" },
            { "type": "null" }
          ]
        },
        "version": {
          "oneOf": [
            { "$ref": "#/definitions/span" },
            { "type": "null" }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Optional contextual hints",
      "additionalProperties": false,
      "properties": {
        "os_hint": {
          "type": ["string", "null"],
          "description": "Operating system hint"
        },
        "shell_type": {
          "type": ["string", "null"],
          "description": "Shell type hint"
        }
      }
    },
    "paraphrase_group": {
      "type": ["string", "null"],
      "description": "Groups paraphrased variants of the same intent"
    }
  },
  "definitions": {
    "span": {
      "type": "object",
      "required": ["start", "end", "text"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "description": "Start character index (0-based)"
        },
        "end": {
          "type": "integer",
          "description": "End character index (exclusive)"
        },
        "text": {
          "type": "string",
          "description": "Matched text"
        }
      }
    }
  }
}
